# Copie para .env.local e ajuste se precisar (o .env.local não vai para o git).

# Por padrão o front usa a API Java real: "npm run dev" encaminha /api para API_PROXY_TARGET.
# Para usar a API simulada (sem back-end/Oracle), rode "npm run dev:demo" ou defina VITE_USE_MOCK=true.
# VITE_USE_MOCK=true

# Para onde o servidor do Vite encaminha as chamadas /api (dev e preview).
# API_PROXY_TARGET=http://localhost:8080

# Endereço da API usado pelo navegador. O padrão "/api" passa pelo proxy acima.
# Num deploy sem proxy, use o endereço completo, ex.: https://api.meusite.com/api
# VITE_API_URL=/api

# Atraso artificial das respostas simuladas (ms). Padrão: 250 no dev, 0 no build.
# VITE_MOCK_DELAY=250
