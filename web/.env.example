# Copie para .env.local e ajuste se precisar.

# true  = usa a API simulada no navegador (não precisa do back-end nem do Oracle)
# false = chama a API Java de verdade em VITE_API_URL
VITE_USE_MOCK=true

# Endereço da API Java (usado quando VITE_USE_MOCK=false)
VITE_API_URL=http://localhost:8080/api

# Atraso artificial das respostas simuladas, em milissegundos.
# Sem esta linha: 250 no "npm run dev" e 0 no build. Descomente para forçar um valor.
# VITE_MOCK_DELAY=250
