  "proposals": [
    {
      "id": "d501c4b6-ecba-4430-89a0-a40152b0d6bc",
      "title": "Ciclovia ligando o bairro à estação de trem",
      "description": "Criar uma ciclovia segura do bairro até a estação, incentivando o uso da bicicleta.",
      "body": "Muitos moradores usam a bicicleta para chegar à estação de trem, mas precisam dividir a pista com carros e ônibus em um trecho sem acostamento. Propomos uma ciclovia segregada ligando o bairro à estação, com sinalização e iluminação adequadas e um bicicletário na chegada. A obra reduz o risco de acidentes, incentiva um meio de transporte barato e sustentável e diminui o tráfego de carros nas ruas do bairro.",
      "status": "COLLECTING_VOTES",
      "createdBy": "0bd69764-6100-4f99-b035-d2f3e11f2c5a",
      "archivedAt": null,
      "archivedBy": null,
      "createdAt": "2026-07-06T11:00:00",
      "updatedAt": "2026-07-06T11:00:00"
    },
    {
      "id": "c4197a10-20b2-4ad5-933f-2ef8337565e1",
      "title": "Lixeiras de coleta seletiva nas esquinas do bairro",
      "description": "Instalar lixeiras de coleta seletiva nas principais esquinas e na praça.",
      "body": "Hoje o bairro tem poucas lixeiras e nenhuma separa o lixo reciclável, o que faz o material acabar misturado nas calçadas e nos bueiros. Propomos instalar conjuntos de lixeiras para orgânicos, recicláveis e rejeitos nas principais esquinas e na praça, com identificação por cores e informações simples sobre o que descartar em cada uma. A medida reduz o entupimento de bueiros, aumenta a reciclagem e melhora a limpeza das ruas.",
      "status": "COMPLETED",
      "createdBy": "4b292ded-b5d7-4551-a806-21f7ba62e9c5",
      "archivedAt": null,
      "archivedBy": null,
      "createdAt": "2026-08-03T09:30:00",
      "updatedAt": "2026-10-05T16:00:00"
    },
    {
      "id": "2d6e1376-26e6-4223-bbbd-5fb8e2de5bac",
      "title": "Reforma da Praça das Acácias e iluminação em LED",
      "description": "Recuperar a praça com novos bancos, calçada acessível e iluminação em LED.",
      "body": "A Praça das Acácias tem calçadas quebradas, postes apagados e poucos bancos. À noite ela fica escura e os moradores evitam passar por ali. Propomos recuperar a calçada com piso regular e rampas de acesso, trocar a iluminação por lâmpadas de LED, instalar bancos e lixeiras e podar as árvores que cobrem os postes. A reforma melhora a segurança, a acessibilidade e o uso da praça pela comunidade, e a iluminação de LED reduz o gasto de energia.",
      "status": "IN_PROGRESS",
      "createdBy": "754840d7-8b19-43bf-874b-ef7b33e1aa1f",
      "archivedAt": null,
      "archivedBy": null,
      "createdAt": "2026-09-14T09:00:00",
      "updatedAt": "2026-10-20T10:00:00"
    },
    {
      "id": "298cb0f7-8414-45be-ba10-28989c91b091",
      "title": "Proibir o estacionamento em toda a Avenida Central",
      "description": "Proibir o estacionamento nos dois lados da avenida para liberar uma faixa extra de circulação.",
      "body": "A Avenida Central fica congestionada nos horários de pico porque os carros estacionados reduzem a via a uma faixa em cada sentido. Propomos proibir o estacionamento nos dois lados da avenida, em toda a sua extensão, para liberar uma faixa extra de circulação e agilizar o transporte coletivo. A medida reduziria o tempo de deslocamento, mas também afeta o comércio local e os moradores sem garagem, e por isso deve ser debatida.",
      "status": "REJECTED",
      "createdBy": "f9322f82-6a45-4b9b-937f-82683d3930d9",
      "archivedAt": "2026-10-13T15:00:00",
      "archivedBy": "c2225dc9-96f0-4e7a-ab09-113e7f776d5f",
      "createdAt": "2026-10-01T10:00:00",
      "updatedAt": "2026-10-13T15:00:00"
    },
    {
      "id": "3b6b4d85-da92-41da-9c85-c6c2073b7ea8",
      "title": "Horta comunitária no terreno baldio da Rua dos Ipês",
      "description": "Transformar o terreno abandonado em uma horta comunitária cuidada pelos moradores.",
      "body": "O terreno ao lado do número 120 da Rua dos Ipês está abandonado há anos e acumula entulho e mato alto. Propomos transformá-lo em uma horta comunitária, com canteiros cuidados pelos moradores, composteira para os resíduos orgânicos do bairro e um espaço de convivência com bancos. A prefeitura cederia o uso do terreno e forneceria água e as primeiras mudas. A horta melhora a limpeza do local, reduz o descarte irregular e oferece alimentos frescos e atividades para crianças e idosos.",
      "status": "AWAITING_REVIEW",
      "createdBy": "e372b44f-6771-44bf-aabe-d3411d7f7487",
      "archivedAt": null,
      "archivedBy": null,
      "createdAt": "2026-11-02T09:15:00",
      "updatedAt": "2026-11-04T08:00:00"
    },
    {
      "id": "295234f9-f00b-4fa9-8b7c-8f1f5b63a1f6",
      "title": "Semáforo no cruzamento da Rua das Palmeiras com a Avenida Central",
      "description": "Instalar semáforo com botoeira para pedestres no cruzamento mais movimentado do bairro.",
      "body": "O cruzamento da Rua das Palmeiras com a Avenida Central não tem semáforo nem faixa elevada. Nos horários de entrada e saída da escola e do trabalho, pedestres, ciclistas e carros disputam o mesmo espaço, e já houve vários quase-atropelamentos. Propomos a instalação de um semáforo com botoeira e tempo estendido para pedestres, além de sinalização horizontal reforçada e uma faixa elevada. A medida reduz o risco para crianças e idosos e organiza o fluxo de veículos no horário de pico.",
      "status": "COLLECTING_VOTES",
      "createdBy": "71e111a9-adbb-4e38-9776-3631b9b2f3b5",
